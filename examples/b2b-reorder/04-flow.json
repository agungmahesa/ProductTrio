{
  "id": "b2b-reorder",
  "name": "B2B Reorder via WhatsApp (to-be)",
  "description": "Cafe partner reorders matcha through a WhatsApp order link; sales admin confirms stock and payment.",
  "pool": {
    "id": "P-AcmeTea",
    "name": "Acme Tea",
    "lanes": [
      { "id": "L-Buyer", "name": "Cafe buyer" },
      { "id": "L-Sales", "name": "Sales admin" },
      { "id": "L-Warehouse", "name": "Warehouse staff" }
    ]
  },
  "externalPools": [ { "id": "P-Bank", "name": "Payment gateway" } ],
  "nodes": [
    { "id": "E-01", "type": "startEvent", "name": "Reorder needed", "lane": "L-Buyer" },
    { "id": "T-01", "type": "userTask", "name": "Open order link", "lane": "L-Buyer" },
    { "id": "T-02", "type": "userTask", "name": "Submit order", "lane": "L-Buyer" },
    { "id": "T-03", "type": "serviceTask", "name": "Check stock", "lane": "L-Sales" },
    { "id": "G-01", "type": "exclusiveGateway", "name": "Stock available?", "lane": "L-Sales" },
    { "id": "T-04", "type": "userTask", "name": "Offer substitute product", "lane": "L-Sales" },
    { "id": "G-02", "type": "exclusiveGateway", "name": "Substitute accepted?", "lane": "L-Buyer" },
    { "id": "E-09", "type": "endEvent", "name": "Order cancelled", "lane": "L-Buyer" },
    { "id": "G-03", "type": "exclusiveGateway", "name": "", "lane": "L-Sales" },
    { "id": "T-05", "type": "sendTask", "name": "Send payment link", "lane": "L-Sales" },
    { "id": "G-04", "type": "eventBasedGateway", "name": "", "lane": "L-Sales" },
    { "id": "E-02", "type": "intermediateCatchEvent", "event": "message", "name": "Payment received", "lane": "L-Sales" },
    { "id": "E-03", "type": "intermediateCatchEvent", "event": "timer", "timer": "PT24H", "name": "24h passed", "lane": "L-Sales" },
    { "id": "E-10", "type": "endEvent", "name": "Order expired", "lane": "L-Sales" },
    { "id": "G-05", "type": "parallelGateway", "name": "", "lane": "L-Warehouse" },
    { "id": "T-06", "type": "manualTask", "name": "Pack order", "lane": "L-Warehouse" },
    { "id": "T-07", "type": "serviceTask", "name": "Create shipping label", "lane": "L-Warehouse" },
    { "id": "G-06", "type": "parallelGateway", "name": "", "lane": "L-Warehouse" },
    { "id": "T-08", "type": "manualTask", "name": "Hand over to courier", "lane": "L-Warehouse" },
    { "id": "E-11", "type": "endEvent", "event": "message", "name": "Order shipped", "lane": "L-Warehouse" }
  ],
  "flows": [
    { "from": "E-01", "to": "T-01" },
    { "from": "T-01", "to": "T-02" },
    { "from": "T-02", "to": "T-03" },
    { "from": "T-03", "to": "G-01" },
    { "from": "G-01", "to": "G-03", "name": "Yes" },
    { "from": "G-01", "to": "T-04", "name": "No" },
    { "from": "T-04", "to": "G-02" },
    { "from": "G-02", "to": "G-03", "name": "Yes" },
    { "from": "G-02", "to": "E-09", "name": "No" },
    { "from": "G-03", "to": "T-05" },
    { "from": "T-05", "to": "G-04" },
    { "from": "G-04", "to": "E-02" },
    { "from": "G-04", "to": "E-03" },
    { "from": "E-03", "to": "E-10" },
    { "from": "E-02", "to": "G-05" },
    { "from": "G-05", "to": "T-06" },
    { "from": "G-05", "to": "T-07" },
    { "from": "T-06", "to": "G-06" },
    { "from": "T-07", "to": "G-06" },
    { "from": "G-06", "to": "T-08" },
    { "from": "T-08", "to": "E-11" }
  ],
  "messageFlows": [
    { "from": "T-05", "to": "P-Bank", "name": "Payment request" },
    { "from": "P-Bank", "to": "E-02", "name": "Payment confirmation" }
  ]
}
