<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_b2b-reorder" targetNamespace="http://bpmn.io/schema/bpmn" exporter="product-trio bpmn_build" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collab_b2b-reorder">
    <bpmn:participant id="P-AcmeTea" name="Acme Tea" processRef="b2b-reorder" />
    <bpmn:participant id="P-Bank" name="Payment gateway" />
    <bpmn:messageFlow id="MsgFlow_1" name="Payment request" sourceRef="T-05" targetRef="P-Bank" />
    <bpmn:messageFlow id="MsgFlow_2" name="Payment confirmation" sourceRef="P-Bank" targetRef="E-02" />
  </bpmn:collaboration>
  <bpmn:process id="b2b-reorder" name="B2B Reorder via WhatsApp (to-be)" isExecutable="false">
    <bpmn:documentation>Cafe partner reorders matcha through a WhatsApp order link; sales admin confirms stock and payment.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_b2b-reorder">
      <bpmn:lane id="L-Buyer" name="Cafe buyer">
        <bpmn:flowNodeRef>E-01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G-02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-09</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L-Sales" name="Sales admin">
        <bpmn:flowNodeRef>T-03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G-01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G-03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G-04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L-Warehouse" name="Warehouse staff">
        <bpmn:flowNodeRef>G-05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G-06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-11</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E-01" name="Reorder needed">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T-01" name="Open order link">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T-02" name="Submit order">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T-03" name="Check stock">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G-01" name="Stock available?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T-04" name="Offer substitute product">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G-02" name="Substitute accepted?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E-09" name="Order cancelled">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G-03" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T-05" name="Send payment link">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="G-04" name="">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E-02" name="Payment received">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E-02_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E-03" name="24h passed">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="E-03_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E-10" name="Order expired">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="G-05" name="">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="T-06" name="Pack order">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="T-07" name="Create shipping label">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="G-06" name="">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="T-08" name="Hand over to courier">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E-11" name="Order shipped">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:messageEventDefinition id="E-11_def" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="E-01" targetRef="T-01" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="T-01" targetRef="T-02" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="T-02" targetRef="T-03" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="T-03" targetRef="G-01" />
    <bpmn:sequenceFlow id="Flow_5" name="Yes" sourceRef="G-01" targetRef="G-03" />
    <bpmn:sequenceFlow id="Flow_6" name="No" sourceRef="G-01" targetRef="T-04" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="T-04" targetRef="G-02" />
    <bpmn:sequenceFlow id="Flow_8" name="Yes" sourceRef="G-02" targetRef="G-03" />
    <bpmn:sequenceFlow id="Flow_9" name="No" sourceRef="G-02" targetRef="E-09" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="G-03" targetRef="T-05" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="T-05" targetRef="G-04" />
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="G-04" targetRef="E-02" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="G-04" targetRef="E-03" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="E-03" targetRef="E-10" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="E-02" targetRef="G-05" />
    <bpmn:sequenceFlow id="Flow_16" name="" sourceRef="G-05" targetRef="T-06" />
    <bpmn:sequenceFlow id="Flow_17" name="" sourceRef="G-05" targetRef="T-07" />
    <bpmn:sequenceFlow id="Flow_18" name="" sourceRef="T-06" targetRef="G-06" />
    <bpmn:sequenceFlow id="Flow_19" name="" sourceRef="T-07" targetRef="G-06" />
    <bpmn:sequenceFlow id="Flow_20" name="" sourceRef="G-06" targetRef="T-08" />
    <bpmn:sequenceFlow id="Flow_21" name="" sourceRef="T-08" targetRef="E-11" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_b2b-reorder">
    <bpmndi:BPMNPlane id="Plane_b2b-reorder" bpmnElement="Collab_b2b-reorder">
      <bpmndi:BPMNShape id="P-AcmeTea_di" bpmnElement="P-AcmeTea" isHorizontal="true"><dc:Bounds x="0" y="40" width="2680" height="610" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L-Buyer_di" bpmnElement="L-Buyer" isHorizontal="true"><dc:Bounds x="30" y="40" width="2650" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L-Sales_di" bpmnElement="L-Sales" isHorizontal="true"><dc:Bounds x="30" y="170" width="2650" height="240" /></bpmndi:BPMNShape>
