      <bpmndi:BPMNEdge id="MsgFlow_2_di" bpmnElement="MsgFlow_2"><di:waypoint x="1785" y="690" /><di:waypoint x="1785" y="253" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
