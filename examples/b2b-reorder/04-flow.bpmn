      <bpmndi:BPMNShape id="E-03_di" bpmnElement="E-03"><dc:Bounds x="1752" y="327" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1720" y="367" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E-10_di" bpmnElement="E-10"><dc:Bounds x="1912" y="217" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1880" y="257" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G-05_di" bpmnElement="G-05"><dc:Bounds x="1905" y="450" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T-06_di" bpmnElement="T-06"><dc:Bounds x="2040" y="435" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T-07_di" bpmnElement="T-07"><dc:Bounds x="2040" y="545" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G-06_di" bpmnElement="G-06"><dc:Bounds x="2225" y="450" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T-08_di" bpmnElement="T-08"><dc:Bounds x="2360" y="435" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E-11_di" bpmnElement="E-11"><dc:Bounds x="2552" y="457" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2520" y="497" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-Bank_di" bpmnElement="P-Bank" isHorizontal="true"><dc:Bounds x="0" y="690" width="2680" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="105" /><di:waypoint x="280" y="105" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="380" y="105" /><di:waypoint x="440" y="105" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="540" y="105" /><di:waypoint x="570" y="105" /><di:waypoint x="570" y="235" /><di:waypoint x="600" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="700" y="235" /><di:waypoint x="785" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="810" y="260" /><di:waypoint x="810" y="289" /><di:waypoint x="1290" y="289" /><di:waypoint x="1290" y="260" /><bpmndi:BPMNLabel><dc:Bounds x="865" y="273" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="835" y="235" /><di:waypoint x="920" y="235" /><bpmndi:BPMNLabel><dc:Bounds x="881.5" y="217" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1020" y="235" /><di:waypoint x="1062.5" y="235" /><di:waypoint x="1062.5" y="105" /><di:waypoint x="1105" y="105" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1130" y="130" /><di:waypoint x="1130" y="235" /><di:waypoint x="1265" y="235" /><bpmndi:BPMNLabel><dc:Bounds x="1136" y="175.5" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
