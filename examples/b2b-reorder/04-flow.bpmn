      <bpmndi:BPMNShape id="G-01_di" bpmnElement="G-01" isMarkerVisible="true"><dc:Bounds x="785" y="210" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="760" y="264" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
