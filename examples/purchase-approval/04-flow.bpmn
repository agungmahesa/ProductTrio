<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="product-trio bpmn_build" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collab_approval">
    <bpmn:participant id="Pool_main" name="Company" processRef="approval" />
  </bpmn:collaboration>
  <bpmn:process id="approval" name="Purchase approval with rework loop" isExecutable="false">
    <bpmn:laneSet id="LaneSet_approval">
      <bpmn:lane id="L-Req" name="Requester">
        <bpmn:flowNodeRef>E-01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L-Mgr" name="Manager">
        <bpmn:flowNodeRef>G-02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G-01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-02</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E-01" name="Need item">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T-01" name="Fill request">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G-02" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T-02" name="Review request">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G-01" name="Approved?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T-03" name="Revise request">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E-02" name="Request approved">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="E-01" targetRef="T-01" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="T-01" targetRef="G-02" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="T-02" targetRef="G-01" />
    <bpmn:sequenceFlow id="Flow_4" name="Yes" sourceRef="G-01" targetRef="E-02" />
    <bpmn:sequenceFlow id="Flow_5" name="Needs changes" sourceRef="G-01" targetRef="T-03" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="T-03" targetRef="G-02" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="G-02" targetRef="T-02" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_approval">
    <bpmndi:BPMNPlane id="Plane_approval" bpmnElement="Collab_approval">
      <bpmndi:BPMNShape id="Pool_main_di" bpmnElement="Pool_main" isHorizontal="true"><dc:Bounds x="0" y="40" width="1080" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L-Req_di" bpmnElement="L-Req" isHorizontal="true"><dc:Bounds x="30" y="40" width="1050" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L-Mgr_di" bpmnElement="L-Mgr" isHorizontal="true"><dc:Bounds x="30" y="170" width="1050" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E-01_di" bpmnElement="E-01"><dc:Bounds x="152" y="87" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="120" y="127" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T-01_di" bpmnElement="T-01"><dc:Bounds x="280" y="65" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G-02_di" bpmnElement="G-02" isMarkerVisible="true"><dc:Bounds x="465" y="210" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T-02_di" bpmnElement="T-02"><dc:Bounds x="600" y="195" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G-01_di" bpmnElement="G-01" isMarkerVisible="true"><dc:Bounds x="785" y="210" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="760" y="264" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T-03_di" bpmnElement="T-03"><dc:Bounds x="920" y="65" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E-02_di" bpmnElement="E-02"><dc:Bounds x="952" y="217" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="920" y="257" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="105" /><di:waypoint x="280" y="105" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="380" y="105" /><di:waypoint x="422.5" y="105" /><di:waypoint x="422.5" y="235" /><di:waypoint x="465" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="700" y="235" /><di:waypoint x="785" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="835" y="235" /><di:waypoint x="952" y="235" /><bpmndi:BPMNLabel><dc:Bounds x="897.5" y="217" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="810" y="210" /><di:waypoint x="810" y="105" /><di:waypoint x="920" y="105" /><bpmndi:BPMNLabel><dc:Bounds x="816" y="150.5" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1020" y="105" /><di:waypoint x="1040" y="105" /><di:waypoint x="1040" y="293" /><di:waypoint x="490" y="293" /><di:waypoint x="490" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="515" y="235" /><di:waypoint x="600" y="235" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
