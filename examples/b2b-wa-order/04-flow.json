      "to": "E-04"
    },
    {
      "from": "G-03",
      "to": "E-05"
    },
    {
      "from": "E-04",
      "to": "T-06"
    },
    {
      "from": "T-06",
      "to": "G-04"
    },
    {
      "from": "G-04",
      "to": "T-08",
      "name": "Yes"
    },
    {
      "from": "G-04",
      "to": "G-05",
      "name": "No"
    },
    {
      "from": "E-05",
      "to": "G-05"
    },
    {
      "from": "G-05",
      "to": "T-07"
    },
    {
      "from": "T-07",
      "to": "G-02"
    },
    {
      "from": "T-08",
