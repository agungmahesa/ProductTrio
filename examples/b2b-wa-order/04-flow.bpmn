      <bpmndi:BPMNShape id="T-11_di" bpmnElement="T-11"><dc:Bounds x="2680" y="305" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E-10_di" bpmnElement="E-10"><dc:Bounds x="2872" y="327" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2840" y="367" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-Buyer_di" bpmnElement="P-Buyer" isHorizontal="true"><dc:Bounds x="0" y="-70" width="3000" height="70" /></bpmndi:BPMNShape>
