      <bpmndi:BPMNShape id="L-Sales_di" bpmnElement="L-Sales" isHorizontal="true"><dc:Bounds x="30" y="40" width="2970" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L-Order_di" bpmnElement="L-Order" isHorizontal="true"><dc:Bounds x="30" y="280" width="2970" height="130" /></bpmndi:BPMNShape>
