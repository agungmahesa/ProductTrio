<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_b2b-wa-order" targetNamespace="http://bpmn.io/schema/bpmn" exporter="product-trio bpmn_build" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collab_b2b-wa-order">
    <bpmn:participant id="P-AcmeTea" name="Acme Tea" processRef="b2b-wa-order" />
    <bpmn:participant id="P-Buyer" name="Coffee shop (B2B buyer)" />
    <bpmn:participant id="P-RajaOngkir" name="RajaOngkir" />
    <bpmn:participant id="P-Courier" name="Courier (JNE / J&amp;T)" />
    <bpmn:messageFlow id="MsgFlow_1" name="'order' chat" sourceRef="P-Buyer" targetRef="E-01" />
    <bpmn:messageFlow id="MsgFlow_2" name="Order form button" sourceRef="T-01" targetRef="P-Buyer" />
    <bpmn:messageFlow id="MsgFlow_3" name="Completed form" sourceRef="P-Buyer" targetRef="E-02" />
    <bpmn:messageFlow id="MsgFlow_4" name="Rate request" sourceRef="T-02" targetRef="P-RajaOngkir" />
    <bpmn:messageFlow id="MsgFlow_5" name="Order summary" sourceRef="T-03" targetRef="P-Buyer" />
    <bpmn:messageFlow id="MsgFlow_6" name="Invoice + pay link" sourceRef="T-05" targetRef="P-Buyer" />
    <bpmn:messageFlow id="MsgFlow_7" name="'I have paid'" sourceRef="P-Buyer" targetRef="E-04" />
    <bpmn:messageFlow id="MsgFlow_8" name="Payment reminder" sourceRef="T-07" targetRef="P-Buyer" />
    <bpmn:messageFlow id="MsgFlow_9" name="Payment confirmation" sourceRef="T-08" targetRef="P-Buyer" />
    <bpmn:messageFlow id="MsgFlow_10" name="Pickup booking" sourceRef="T-10" targetRef="P-Courier" />
    <bpmn:messageFlow id="MsgFlow_11" name="Tracking number" sourceRef="T-11" targetRef="P-Buyer" />
  </bpmn:collaboration>
  <bpmn:process id="b2b-wa-order" name="B2B order via WhatsApp (to-be)" isExecutable="false">
    <bpmn:documentation>Coffee shop orders matcha through a WhatsApp Flow form; Acme Tea invoices via Jurnal.id, confirms payment manually and ships with JNE/J&amp;T. Every customer message uses the cheapest channel (free service message inside the 24h window, paid utility template outside it).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_b2b-wa-order">
      <bpmn:lane id="L-Sales" name="Sales admin">
        <bpmn:flowNodeRef>E-01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G-01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G-02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G-03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G-04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G-05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-07</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L-Order" name="Order team">
        <bpmn:flowNodeRef>T-09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E-01" name="Order request received">
      <bpmn:documentation>Buyer types 'order' in WhatsApp, or Sales admin taps 'Send order form' in admin.</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E-01_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T-01" name="Send order form">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="G-01" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E-02" name="Form submitted">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E-02_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E-03" name="Form link expired">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="E-03_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T-02" name="Recalculate price and shipping">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E-09" name="Order abandoned">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T-03" name="Save order and send summary">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T-04" name="Create invoice in Jurnal.id">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T-05" name="Send invoice">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="G-02" name="">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="G-03" name="">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E-04" name="Payment claimed">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E-04_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E-05" name="2 days unpaid">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="E-05_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T-06" name="Check bank mutation">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G-04" name="Payment matches invoice?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T-08" name="Mark order paid">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G-05" name="">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T-07" name="Follow up payment">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="T-09" name="Pack order">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="T-10" name="Book courier and enter tracking">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T-11" name="Send tracking number">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E-10" name="Order shipped">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="E-01" targetRef="T-01" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="T-01" targetRef="G-01" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="G-01" targetRef="E-02" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="G-01" targetRef="E-03" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="E-03" targetRef="E-09" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="E-02" targetRef="T-02" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="T-02" targetRef="T-03" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="T-03" targetRef="T-04" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="T-04" targetRef="T-05" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="T-05" targetRef="G-02" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="G-02" targetRef="G-03" />
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="G-03" targetRef="E-04" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="G-03" targetRef="E-05" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="E-04" targetRef="T-06" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="T-06" targetRef="G-04" />
    <bpmn:sequenceFlow id="Flow_16" name="Yes" sourceRef="G-04" targetRef="T-08" />
    <bpmn:sequenceFlow id="Flow_17" name="No" sourceRef="G-04" targetRef="G-05" />
    <bpmn:sequenceFlow id="Flow_18" name="" sourceRef="E-05" targetRef="G-05" />
    <bpmn:sequenceFlow id="Flow_19" name="" sourceRef="G-05" targetRef="T-07" />
    <bpmn:sequenceFlow id="Flow_20" name="" sourceRef="T-07" targetRef="G-02" />
    <bpmn:sequenceFlow id="Flow_21" name="" sourceRef="T-08" targetRef="T-09" />
    <bpmn:sequenceFlow id="Flow_22" name="" sourceRef="T-09" targetRef="T-10" />
    <bpmn:sequenceFlow id="Flow_23" name="" sourceRef="T-10" targetRef="T-11" />
    <bpmn:sequenceFlow id="Flow_24" name="" sourceRef="T-11" targetRef="E-10" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_b2b-wa-order">
    <bpmndi:BPMNPlane id="Plane_b2b-wa-order" bpmnElement="Collab_b2b-wa-order">
